{
  "name": "papyrus-analyzer",
  "displayName": "Papyrus Analyzer",
  "description": "Language support for Skyrim's Papyrus scripting language: diagnostics, completion, hover, go to definition, references and more.",
  "version": "0.2.1",
  "publisher": "SARDONYX",
  "license": "MIT OR Apache-2.0",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e2533",
    "theme": "dark"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/SARDONYX-sard/papyrus"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:papyrus.toml",
    "onDebugResolve:papyrus"
  ],
  "main": "build/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "papyrus",
        "aliases": [
          "Papyrus",
          "papyrus"
        ],
        "extensions": [
          ".psc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/psc.svg",
          "dark": "./resources/psc.svg"
        }
      },
      {
        "extensions": [
          ".flg"
        ],
        "aliases": [
          "Papyrus Flags"
        ],
        "configuration": "./flags-language-configuration.json",
        "id": "papyrus-flags",
        "icon": {
          "light": "./resources/flg.svg",
          "dark": "./resources/flg.svg"
        }
      },
      {
        "id": "papyrus-assembly",
        "aliases": [
          "Papyrus Assembly"
        ],
        "filenamePatterns": [
          "* (assembly).pas"
        ],
        "configuration": "./assembly-language-configuration.json",
        "icon": {
          "light": "./resources/pas.svg",
          "dark": "./resources/pas.svg"
        }
      },
      {
        "id": "papyrus-compiled",
        "aliases": [
          "Papyrus Compiled Script"
        ],
        "extensions": [
          ".pex"
        ],
        "icon": {
          "light": "./resources/pex.svg",
          "dark": "./resources/pex.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "papyrus",
        "scopeName": "source.papyrus",
        "path": "./syntaxes/papyrus.tmLanguage.json"
      },
      {
        "path": "./syntaxes/papyrus-flags.tmLanguage.json",
        "language": "papyrus-flags",
        "scopeName": "source.papyrus-flags"
      },
      {
        "path": "./syntaxes/papyrus-assembly.tmLanguage.json",
        "language": "papyrus-assembly",
        "scopeName": "source.papyrus-assembly"
      },
      {
        "scopeName": "markdown.papyrus.codeblock",
        "path": "./syntaxes/markdown-papyrus.injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.papyrus": "papyrus"
        }
      },
      {
        "scopeName": "markdown.papyrus-flags.codeblock",
        "path": "./syntaxes/markdown-papyrus-flags.injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.papyrus-flags": "papyrus-flags"
        }
      }
    ],
    "commands": [
      {
        "command": "papyrus.restartServer",
        "title": "Restart Language Server",
        "category": "Papyrus",
        "icon": "$(debug-restart)"
      },
      {
        "command": "papyrus.showStatus",
        "title": "Show Language Server Status",
        "category": "Papyrus"
      },
      {
        "command": "papyrus.showSyntaxTree",
        "title": "Show Syntax Tree",
        "category": "Papyrus"
      },
      {
        "title": "Compile Script",
        "icon": "$(play)",
        "command": "papyrus.compile",
        "category": "Papyrus"
      },
      {
        "title": "Compile All Scripts",
        "icon": "$(run-all)",
        "command": "papyrus.compileAll",
        "category": "Papyrus"
      },
      {
        "title": "Create papyrus.toml",
        "command": "papyrus.createManifest",
        "category": "Papyrus"
      },
      {
        "title": "Format Project",
        "command": "papyrus.formatProject",
        "category": "Papyrus"
      },
      {
        "title": "Lint Project",
        "command": "papyrus.lintProject",
        "category": "Papyrus"
      },
      {
        "title": "Lint Project: Fix All",
        "command": "papyrus.fixProject",
        "category": "Papyrus"
      },
      {
        "title": "Compile Selected Scripts…",
        "category": "Papyrus",
        "icon": "$(run-all)",
        "command": "papyrus.compileSelected"
      },
      {
        "title": "Decompile",
        "category": "Papyrus",
        "icon": "$(file-code)",
        "command": "papyrus.decompile"
      },
      {
        "title": "Show Assembly",
        "category": "Papyrus",
        "icon": "$(file-binary)",
        "command": "papyrus.showAssembly"
      },
      {
        "title": "Switch to Compile Mode",
        "category": "Papyrus",
        "icon": "$(file-code)",
        "command": "papyrus.explorer.compileMode"
      },
      {
        "title": "Switch to Decompile Mode",
        "category": "Papyrus",
        "icon": "$(file-binary)",
        "command": "papyrus.explorer.decompileMode"
      },
      {
        "title": "Compile All",
        "category": "Papyrus",
        "icon": "$(run-all)",
        "command": "papyrus.explorer.compileAll"
      },
      {
        "title": "Decompile All",
        "category": "Papyrus",
        "icon": "$(run-all)",
        "command": "papyrus.explorer.decompileAll"
      },
      {
        "title": "Refresh",
        "category": "Papyrus",
        "icon": "$(refresh)",
        "command": "papyrus.explorer.refresh"
      },
      {
        "title": "Expand All",
        "category": "Papyrus",
        "icon": "$(expand-all)",
        "command": "papyrus.explorer.expandAll"
      },
      {
        "title": "Expand All Below",
        "category": "Papyrus",
        "icon": "$(expand-all)",
        "command": "papyrus.explorer.expandFolder"
      },
      {
        "title": "Collapse All Below",
        "category": "Papyrus",
        "icon": "$(collapse-all)",
        "command": "papyrus.explorer.collapseFolder"
      },
      {
        "title": "Compile",
        "category": "Papyrus",
        "icon": "$(play)",
        "command": "papyrus.explorer.compile"
      },
      {
        "title": "Decompile",
        "category": "Papyrus",
        "icon": "$(play)",
        "command": "papyrus.explorer.decompile"
      },
      {
        "title": "Run Tests",
        "category": "Papyrus",
        "icon": "$(beaker)",
        "command": "papyrus.explorer.runTests"
      },
      {
        "title": "Open",
        "category": "Papyrus",
        "command": "papyrus.explorer.open"
      },
      {
        "title": "Assemble (Preview)",
        "category": "Papyrus",
        "command": "papyrus.explorer.assemble"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "papyrus",
          "title": "Papyrus",
          "icon": "resources/papyrus.svg"
        }
      ]
    },
    "views": {
      "papyrus": [
        {
          "id": "papyrus.explorer",
          "name": "Explorer",
          "icon": "resources/papyrus.svg",
          "when": "config.papyrus.explorer.show == always || papyrus.hasScripts"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "papyrus.pexViewer",
        "displayName": "Papyrus Decompiler",
        "selector": [
          {
            "filenamePattern": "*.pex"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Papyrus",
      "properties": {
        "papyrus.server.path": {
          "type": "string",
          "default": "",
          "description": "Path of the `papyrus_analyzer` executable. Empty uses the bundled server.",
          "scope": "machine-overridable"
        },
        "papyrus.importDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra script source directories, in lookup order. Supports `${NAME}` variables (see `#papyrus.var#`), `${env:NAME}`, `${workspaceFolder}` and `~`. Without `papyrus.toml`, the game scripts of `SKYRIM_DIR` (or of the installation found in the registry) are imported automatically.",
          "scope": "machine-overridable"
        },
        "papyrus.semanticDiagnostics": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report unknown types, members and names. Only active once the base game scripts (`Form.psc`, ...) are found in the workspace or in `#papyrus.importDirectories#`."
        },
        "papyrus.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        },
        "papyrus.flagsFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "The flags file (`TESV_Papyrus_Flags.flg`) when `papyrus.toml` does not set `[build] flags`. Empty: the first `.flg` found in the workspace or import directories, else the built-in Skyrim flags.",
          "scope": "machine-overridable"
        },
        "papyrus.server.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "markdownDescription": "Extra command line arguments of the server, e.g. `[\"--var\", \"SKYRIM_DIR=...\"]`. See `papyrus_analyzer --help`. Takes effect after reloading the window."
        },
        "papyrus.var": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "machine-overridable",
          "markdownDescription": "Values of `${NAME}` variables used by `papyrus.toml` and by the path settings, e.g. `{ \"SKYRIM_DIR\": \"${game:SkyrimSE}\" }`. Put machine specific paths here (user settings) instead of in the committed `papyrus.toml`. Wins over `[var]` of `papyrus.local.toml` and `papyrus.toml`; an undefined variable is an error. Values may use `${game:SkyrimSE}` (installation from the registry, Windows only: `SkyrimLE`, `SkyrimSE`, `SkyrimVR`, `Enderal`, `EnderalSE`), `${env:NAME}` (environment variables) and `${workspaceFolder}`."
        },
        "papyrus.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show parameter names before call arguments, e.g. `Debug.Trace(asTextToPrint: msg)`. Hidden for named arguments and for arguments spelled like the parameter (`actor` for `akActor`)."
        },
        "papyrus.inlayHints.overrides": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show `overrides Quest` after functions and events replacing one of a parent script, and `event of Form` after events the game sends. Click the script name to go to the replaced declaration."
        },
        "papyrus.explorer.show": {
          "type": "string",
          "enum": [
            "auto",
            "always"
          ],
          "enumDescriptions": [
            "Only in workspaces with Papyrus: a `papyrus.toml`, or `.psc` / `.pex` files (found once the extension starts: on opening a script or with a `papyrus.toml`).",
            "In every workspace."
          ],
          "default": "auto",
          "markdownDescription": "When the Papyrus view shows up in the activity bar. `auto` keeps its icon away from repositories without Papyrus."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "papyrus",
        "scopes": {
          "event": [
            "entity.name.function.event.papyrus"
          ],
          "decorator": [
            "storage.modifier.papyrus"
          ]
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == papyrus && resourceScheme == file",
          "command": "papyrus.compile",
          "group": "navigation"
        },
        {
          "when": "resourceScheme == papyrus-pex && resourceExtname == .psc",
          "command": "papyrus.showAssembly",
          "group": "navigation"
        },
        {
          "when": "resourceScheme == papyrus-pex && resourceExtname == .pas",
          "command": "papyrus.decompile",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "papyrus.compile",
          "when": "resourceLangId == papyrus && resourceScheme == file"
        },
        {
          "command": "papyrus.createManifest",
          "when": "!papyrus.hasManifest"
        },
        {
          "command": "papyrus.formatProject",
          "when": "papyrus.hasManifest"
        },
        {
          "command": "papyrus.lintProject",
          "when": "papyrus.hasManifest"
        },
        {
          "command": "papyrus.fixProject",
          "when": "papyrus.hasManifest"
        },
        {
          "command": "papyrus.decompile",
          "when": "resourceScheme == papyrus-pex"
        },
        {
          "command": "papyrus.showAssembly",
          "when": "resourceScheme == papyrus-pex"
        },
        {
          "command": "papyrus.explorer.compile",
          "when": "false"
        },
        {
          "command": "papyrus.explorer.decompile",
          "when": "false"
        },
        {
          "command": "papyrus.explorer.compileAll",
          "when": "false"
        },
        {
          "command": "papyrus.explorer.expandFolder",
          "when": "false"
        },
        {
          "command": "papyrus.explorer.collapseFolder",
          "when": "false"
        },
        {
          "command": "papyrus.explorer.decompileAll",
          "when": "false"
        },
        {
          "command": "papyrus.explorer.open",
          "when": "false"
        },
        {
          "command": "papyrus.explorer.runTests",
          "when": "false"
        },
        {
          "command": "papyrus.explorer.assemble",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .psc",
          "command": "papyrus.compile",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "papyrus.compileSelected",
          "when": "view == papyrus.explorer && papyrus.explorerMode != decompile",
          "group": "navigation@1"
        },
        {
          "command": "papyrus.explorer.compileAll",
          "when": "view == papyrus.explorer && papyrus.explorerMode != decompile",
          "group": "navigation@2"
        },
        {
          "command": "papyrus.explorer.decompileAll",
          "when": "view == papyrus.explorer && papyrus.explorerMode == decompile",
          "group": "navigation@2"
        },
        {
          "command": "papyrus.explorer.refresh",
          "when": "view == papyrus.explorer",
          "group": "navigation@3"
        },
        {
          "command": "papyrus.explorer.expandAll",
          "when": "view == papyrus.explorer",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "papyrus.restartServer",
          "when": "view == papyrus.explorer && viewItem == papyrusServer",
          "group": "inline"
        },
        {
          "command": "papyrus.explorer.expandFolder",
          "when": "view == papyrus.explorer && viewItem =~ /^papyrusFolder/",
          "group": "inline@1"
        },
        {
          "command": "papyrus.explorer.collapseFolder",
          "when": "view == papyrus.explorer && viewItem =~ /^papyrusFolder/",
          "group": "inline@2"
        },
        {
          "command": "papyrus.explorer.compile",
          "when": "view == papyrus.explorer && papyrus.explorerMode != decompile && viewItem =~ /^papyrus(File|Folder)$/",
          "group": "inline"
        },
        {
          "command": "papyrus.explorer.decompile",
          "when": "view == papyrus.explorer && papyrus.explorerMode == decompile && viewItem =~ /^papyrus(File|Folder)$/",
          "group": "inline"
        },
        {
          "command": "papyrus.explorer.compile",
          "when": "view == papyrus.explorer && papyrus.explorerMode != decompile && viewItem =~ /^papyrus(File|Folder)$/",
          "group": "1_run"
        },
        {
          "command": "papyrus.explorer.decompile",
          "when": "view == papyrus.explorer && papyrus.explorerMode == decompile && viewItem =~ /^papyrus(File|Folder)$/",
          "group": "1_run"
        },
        {
          "command": "papyrus.explorer.runTests",
          "when": "view == papyrus.explorer && viewItem =~ /^papyrus(FileTest|FolderTests)$/",
          "group": "inline"
        },
        {
          "command": "papyrus.explorer.runTests",
          "when": "view == papyrus.explorer && viewItem =~ /^papyrus(FileTest|FolderTests)$/",
          "group": "1_run"
        },
        {
          "command": "papyrus.explorer.open",
          "when": "view == papyrus.explorer && viewItem =~ /^papyrusFile(Other|Test)?$/",
          "group": "1_run"
        },
        {
          "command": "papyrus.explorer.assemble",
          "when": "view == papyrus.explorer && viewItem =~ /^papyrusFile(Other|Test)?$/",
          "group": "1_run"
        }
      ]
    },
    "keybindings": [
      {
        "when": "editorLangId == papyrus && resourceScheme == file",
        "command": "papyrus.compile",
        "key": "ctrl+shift+b"
      }
    ],
    "problemMatchers": [
      {
        "name": "papyrus",
        "owner": "papyrus",
        "source": "PapyrusCompiler",
        "pattern": {
          "regexp": "^(.*?\\.psc)\\((\\d+),(\\d+)\\):\\s*(.*)$",
          "line": 2,
          "message": 4,
          "column": 3,
          "file": 1
        },
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ]
      }
    ],
    "taskDefinitions": [
      {
        "properties": {
          "all": {
            "description": "Compile every script of [build] sources.",
            "type": "boolean"
          },
          "files": {
            "type": "array",
            "description": "The scripts to compile.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [],
        "type": "papyrus"
      }
    ],
    "breakpoints": [
      {
        "language": "papyrus"
      }
    ],
    "debuggers": [
      {
        "type": "papyrus",
        "label": "Papyrus VM",
        "languages": [
          "papyrus"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "test": {
                "type": "string",
                "markdownDescription": "The `; #[test]` function to debug, `Script.Function`."
              },
              "run": {
                "type": "string",
                "markdownDescription": "The function to debug, `Script.Function`, run on a new object of `Script` (like `papyrus_analyzer run`)."
              },
              "args": {
                "type": "array",
                "description": "The arguments of `run`: Int, Float, Bool, None or String.",
                "items": {}
              },
              "cwd": {
                "type": "string",
                "description": "The folder of papyrus.toml: its scripts and imports are compiled in memory.",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause at the first line.",
                "default": false
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Papyrus VM: Debug a test",
            "body": {
              "type": "papyrus",
              "request": "launch",
              "name": "Debug ${1:Script.Function}",
              "test": "${1:Script.Function}",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ],
    "tomlValidation": [
      {
        "fileMatch": "papyrus.toml",
        "url": "./schemas/papyrus.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "vite build --config extension/vite.config.ts",
    "build:server": "cargo build --release",
    "release": "npm run compile && npm run build:server && node ./tasks.cjs build",
    "package": "npm run build:server && node ./tasks.cjs build --vsix",
    "release:major": "node ./tasks.cjs release major",
    "release:minor": "node ./tasks.cjs release minor",
    "release:patch": "node ./tasks.cjs release patch",
    "release:current": "node ./tasks.cjs release current",
    "tag": "node ./tasks.cjs tag",
    "check": "tsc -p ./extension",
    "compile:debug": "vite build --config extension/vite.config.ts --mode development",
    "debug": "npm run compile:debug && cargo build && node ./tasks.cjs build --profile debug",
    "grammar": "node syntaxes/generate.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vscode-languageclient": "^10.1.0"
  }
}
