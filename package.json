{
  "name": "papyrus-analyzer",
  "displayName": "Papyrus Analyzer",
  "description": "Language support for Skyrim's Papyrus scripting language: diagnostics, completion, hover, go to definition, references and more.",
  "version": "0.0.1",
  "publisher": "SARDONYX",
  "license": "MIT OR Apache-2.0",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e2533",
    "theme": "dark"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/SARDONYX-sard/papyrus"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/*.psc"
  ],
  "main": "build/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "papyrus",
        "aliases": [
          "Papyrus",
          "papyrus"
        ],
        "extensions": [
          ".psc"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "extensions": [
          ".flg"
        ],
        "aliases": [
          "Papyrus Flags"
        ],
        "configuration": "./flags-language-configuration.json",
        "id": "papyrus-flags"
      }
    ],
    "grammars": [
      {
        "language": "papyrus",
        "scopeName": "source.papyrus",
        "path": "./syntaxes/papyrus.tmLanguage.json"
      },
      {
        "path": "./syntaxes/papyrus-flags.tmLanguage.json",
        "language": "papyrus-flags",
        "scopeName": "source.papyrus-flags"
      },
      {
        "scopeName": "markdown.papyrus.codeblock",
        "path": "./syntaxes/markdown-papyrus.injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.papyrus": "papyrus"
        }
      },
      {
        "scopeName": "markdown.papyrus-flags.codeblock",
        "path": "./syntaxes/markdown-papyrus-flags.injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.papyrus-flags": "papyrus-flags"
        }
      }
    ],
    "commands": [
      {
        "command": "papyrus.restartServer",
        "title": "Restart Language Server",
        "category": "Papyrus"
      },
      {
        "command": "papyrus.showStatus",
        "title": "Show Language Server Status",
        "category": "Papyrus"
      },
      {
        "command": "papyrus.showSyntaxTree",
        "title": "Show Syntax Tree",
        "category": "Papyrus"
      },
      {
        "title": "Compile Script",
        "icon": "$(play)",
        "command": "papyrus.compile",
        "category": "Papyrus"
      },
      {
        "title": "Compile All Scripts",
        "icon": "$(run-all)",
        "command": "papyrus.compileAll",
        "category": "Papyrus"
      },
      {
        "title": "Create papyrus.toml",
        "command": "papyrus.createManifest",
        "category": "Papyrus"
      },
      {
        "title": "Compile Selected Scripts…",
        "category": "Papyrus",
        "icon": "$(run-all)",
        "command": "papyrus.compileSelected"
      },
      {
        "title": "Decompile",
        "category": "Papyrus",
        "icon": "$(file-code)",
        "command": "papyrus.decompile"
      },
      {
        "title": "Show Assembly",
        "category": "Papyrus",
        "icon": "$(file-binary)",
        "command": "papyrus.showAssembly"
      },
      {
        "title": "Switch to Compile Mode",
        "category": "Papyrus",
        "icon": "$(file-code)",
        "command": "papyrus.scripts.compileMode"
      },
      {
        "title": "Switch to Decompile Mode",
        "category": "Papyrus",
        "icon": "$(file-binary)",
        "command": "papyrus.scripts.decompileMode"
      },
      {
        "title": "Run All",
        "category": "Papyrus",
        "icon": "$(run-all)",
        "command": "papyrus.scripts.runAll"
      },
      {
        "title": "Refresh",
        "category": "Papyrus",
        "icon": "$(refresh)",
        "command": "papyrus.scripts.refresh"
      },
      {
        "title": "Expand All",
        "category": "Papyrus",
        "icon": "$(expand-all)",
        "command": "papyrus.scripts.expandAll"
      },
      {
        "title": "Run",
        "category": "Papyrus",
        "icon": "$(play)",
        "command": "papyrus.scripts.run"
      },
      {
        "title": "Open",
        "category": "Papyrus",
        "command": "papyrus.scripts.open"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "papyrus",
          "title": "Papyrus",
          "icon": "resources/papyrus.svg"
        }
      ]
    },
    "views": {
      "papyrus": [
        {
          "id": "papyrus.scripts",
          "name": "Scripts",
          "icon": "resources/papyrus.svg"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "papyrus.pexViewer",
        "displayName": "Papyrus Decompiler",
        "selector": [
          {
            "filenamePattern": "*.pex"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Papyrus",
      "properties": {
        "papyrus.server.path": {
          "type": "string",
          "default": "",
          "description": "Path of the `papyrus_analyzer` executable. Empty uses the bundled server.",
          "scope": "machine-overridable"
        },
        "papyrus.importDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra script source directories, in lookup order. Supports `${NAME}` variables (see `#papyrus.var#`), `${env:NAME}`, `${workspaceFolder}` and `~`. Without `papyrus.toml`, the game scripts of `SKYRIM_DIR` (or of the installation found in the registry) are imported automatically.",
          "scope": "machine-overridable"
        },
        "papyrus.semanticDiagnostics": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report unknown types, members and names. Only active once the base game scripts (`Form.psc`, ...) are found in the workspace or in `#papyrus.importDirectories#`."
        },
        "papyrus.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        },
        "papyrus.flagsFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "The flags file (`TESV_Papyrus_Flags.flg`) when `papyrus.toml` does not set `[build] flags`. Empty: the first `.flg` found in the workspace or import directories, else the built-in Skyrim flags.",
          "scope": "machine-overridable"
        },
        "papyrus.server.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "markdownDescription": "Extra command line arguments of the server, e.g. `[\"--var\", \"SKYRIM_DIR=...\"]`. See `papyrus_analyzer --help`. Takes effect after reloading the window."
        },
        "papyrus.var": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "machine-overridable",
          "markdownDescription": "Values of `${NAME}` variables used by `papyrus.toml` and by the path settings, e.g. `{ \"SKYRIM_DIR\": \"${game:SkyrimSE}\" }`. Put machine specific paths here (user settings) instead of in the committed `papyrus.toml`. Wins over `[var]` of `papyrus.local.toml` and `papyrus.toml`; an undefined variable is an error. Values may use `${game:SkyrimSE}` (installation from the registry, Windows only: `SkyrimLE`, `SkyrimSE`, `SkyrimVR`, `Enderal`, `EnderalSE`), `${env:NAME}` (environment variables) and `${workspaceFolder}`."
        },
        "papyrus.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show parameter names before call arguments, e.g. `Debug.Trace(asTextToPrint: msg)`. Hidden for named arguments and for arguments spelled like the parameter (`actor` for `akActor`)."
        },
        "papyrus.inlayHints.overrides": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show `overrides Quest` after functions and events replacing one of a parent script, and `event of Form` after events the game sends. Click the script name to go to the replaced declaration."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "papyrus",
        "scopes": {
          "event": [
            "entity.name.function.event.papyrus"
          ],
          "decorator": [
            "storage.modifier.papyrus"
          ]
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == papyrus && resourceScheme == file",
          "command": "papyrus.compile",
          "group": "navigation"
        },
        {
          "when": "resourceScheme == papyrus-pex && resourceExtname == .psc",
          "command": "papyrus.showAssembly",
          "group": "navigation"
        },
        {
          "when": "resourceScheme == papyrus-pex && resourceExtname == .pas",
          "command": "papyrus.decompile",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "papyrus.compile",
          "when": "resourceLangId == papyrus && resourceScheme == file"
        },
        {
          "command": "papyrus.createManifest",
          "when": "!papyrus.hasManifest"
        },
        {
          "command": "papyrus.decompile",
          "when": "resourceScheme == papyrus-pex"
        },
        {
          "command": "papyrus.showAssembly",
          "when": "resourceScheme == papyrus-pex"
        },
        {
          "command": "papyrus.scripts.run",
          "when": "false"
        },
        {
          "command": "papyrus.scripts.open",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .psc",
          "command": "papyrus.compile",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "papyrus.scripts.runAll",
          "when": "view == papyrus.scripts",
          "group": "navigation@2"
        },
        {
          "command": "papyrus.scripts.refresh",
          "when": "view == papyrus.scripts",
          "group": "navigation@3"
        },
        {
          "command": "papyrus.scripts.expandAll",
          "when": "view == papyrus.scripts",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "papyrus.scripts.run",
          "when": "view == papyrus.scripts && viewItem =~ /^papyrus(File|Folder)$/",
          "group": "inline"
        },
        {
          "command": "papyrus.scripts.run",
          "when": "view == papyrus.scripts && viewItem =~ /^papyrus(File|Folder)$/",
          "group": "1_run"
        },
        {
          "command": "papyrus.scripts.open",
          "when": "view == papyrus.scripts && viewItem =~ /^papyrusFile(Other)?$/",
          "group": "1_run"
        }
      ]
    },
    "keybindings": [
      {
        "when": "editorLangId == papyrus && resourceScheme == file",
        "command": "papyrus.compile",
        "key": "ctrl+shift+b"
      }
    ],
    "problemMatchers": [
      {
        "name": "papyrus",
        "owner": "papyrus",
        "source": "PapyrusCompiler",
        "pattern": {
          "regexp": "^(.*?\\.psc)\\((\\d+),(\\d+)\\):\\s*(.*)$",
          "line": 2,
          "message": 4,
          "column": 3,
          "file": 1
        },
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ]
      }
    ],
    "taskDefinitions": [
      {
        "properties": {
          "all": {
            "description": "Compile every script of [build] sources.",
            "type": "boolean"
          },
          "files": {
            "type": "array",
            "description": "The scripts to compile.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [],
        "type": "papyrus"
      }
    ],
    "tomlValidation": [
      {
        "fileMatch": "papyrus.toml",
        "url": "./schemas/papyrus.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "vite build --config extension/vite.config.ts",
    "build:server": "cargo build --release",
    "release": "npm run compile && npm run build:server && node ./build.cjs",
    "package": "npm run build:server && node ./build.cjs --vsix",
    "check": "tsc -p ./extension",
    "compile:debug": "vite build --config extension/vite.config.ts --mode development",
    "debug": "npm run compile:debug && cargo build && node ./build.cjs --profile debug",
    "grammar": "node syntaxes/generate.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vscode-languageclient": "^10.1.0"
  }
}
