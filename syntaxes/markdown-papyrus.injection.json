{
  "scopeName": "markdown.papyrus.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#papyrus-code-block"
    }
  ],
  "repository": {
    "papyrus-code-block": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:papyrus)(\\s+[^`~]*)?$",
      "name": "markup.fenced_code.block.markdown",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.papyrus",
          "patterns": [
            {
              "include": "source.papyrus"
            }
          ]
        }
      ]
    }
  }
}
