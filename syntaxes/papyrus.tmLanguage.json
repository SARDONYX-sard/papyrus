{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Papyrus",
  "scopeName": "source.papyrus",
  "comment": "Generated by syntaxes/generate.mjs, do not edit. Baseline highlighting: declarations, types, calls, members and variables are colored without the language server; semantic tokens refine it.",
  "patterns": [
    {
      "include": "#line"
    }
  ],
  "repository": {
    "line": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#script-header"
        },
        {
          "include": "#import"
        },
        {
          "include": "#callable-declaration"
        },
        {
          "include": "#property-declaration"
        },
        {
          "include": "#state-declaration"
        },
        {
          "include": "#variable-declaration"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#cast"
        },
        {
          "include": "#new-array"
        },
        {
          "include": "#member-call"
        },
        {
          "include": "#member"
        },
        {
          "include": "#call"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.papyrus",
          "begin": ";/",
          "end": "/;"
        },
        {
          "name": "comment.block.documentation.papyrus",
          "begin": "\\{",
          "end": "\\}"
        },
        {
          "name": "comment.line.semicolon.papyrus",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.papyrus",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.papyrus",
          "match": "\\\\[nt\\\\\"]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.papyrus",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.papyrus",
          "match": "\\b\\d+(\\.\\d+([eE][+-]?\\d+)?)?\\b"
        }
      ]
    },
    "type-name": {
      "patterns": [
        {
          "name": "support.type.primitive.papyrus",
          "match": "(?i:bool|int|float|string)\\b"
        },
        {
          "name": "entity.name.type.class.papyrus",
          "match": "(?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*"
        }
      ]
    },
    "script-header": {
      "match": "(?i)^\\s*(scriptname)\\s+((?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*)(?:\\s+(extends)\\s+((?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*))?",
      "captures": {
        "1": {
          "name": "keyword.other.scriptname.papyrus"
        },
        "2": {
          "name": "entity.name.type.class.papyrus"
        },
        "3": {
          "name": "storage.modifier.extends.papyrus"
        },
        "4": {
          "name": "entity.other.inherited-class.papyrus"
        }
      }
    },
    "import": {
      "match": "(?i)^\\s*(import)\\s+((?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.control.import.papyrus"
        },
        "2": {
          "name": "entity.name.type.class.papyrus"
        }
      }
    },
    "callable-declaration": {
      "comment": "`Int[] Function Name(Type param = default, ...)`: the parameters are scoped as parameters.",
      "begin": "(?i)^\\s*(?:((?:(?i:bool|int|float|string)\\b|(?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*))(\\[\\])?\\s+)?(function|event)\\s+((?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "#type-name"
            }
          ]
        },
        "2": {
          "name": "punctuation.definition.array.papyrus"
        },
        "3": {
          "name": "storage.type.function.papyrus"
        },
        "4": {
          "name": "entity.name.function.papyrus"
        },
        "5": {
          "name": "punctuation.definition.parameters.begin.papyrus"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.papyrus"
        }
      },
      "patterns": [
        {
          "match": "((?:(?i:bool|int|float|string)\\b|(?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*))(\\[\\])?\\s+((?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#type-name"
                }
              ]
            },
            "2": {
              "name": "punctuation.definition.array.papyrus"
            },
            "3": {
              "name": "variable.parameter.papyrus"
            }
          }
        },
        {
          "include": "#expression"
        }
      ]
    },
    "property-declaration": {
      "match": "(?i)^\\s*((?:(?i:bool|int|float|string)\\b|(?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*))(\\[\\])?\\s+(property)\\s+((?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-name"
            }
          ]
        },
        "2": {
          "name": "punctuation.definition.array.papyrus"
        },
        "3": {
          "name": "storage.type.property.papyrus"
        },
        "4": {
          "name": "variable.other.property.papyrus"
        }
      }
    },
    "state-declaration": {
      "match": "(?i)^\\s*(?:(auto)\\s+)?(state)\\s+((?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "storage.modifier.papyrus"
        },
        "2": {
          "name": "storage.type.state.papyrus"
        },
        "3": {
          "name": "entity.name.section.state.papyrus"
        }
      }
    },
    "variable-declaration": {
      "comment": "`Type name` at the start of a line: local and script variables.",
      "match": "(?i)^\\s*((?:(?i:bool|int|float|string)\\b|(?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*))(\\[\\])?\\s+((?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*)\\b",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-name"
            }
          ]
        },
        "2": {
          "name": "punctuation.definition.array.papyrus"
        },
        "3": {
          "name": "variable.other.declaration.papyrus"
        }
      }
    },
    "cast": {
      "match": "(?i)\\b(as)\\s+((?:(?i:bool|int|float|string)\\b|(?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*))(\\[\\])?",
      "captures": {
        "1": {
          "name": "keyword.operator.cast.papyrus"
        },
        "2": {
          "patterns": [
            {
              "include": "#type-name"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.array.papyrus"
        }
      }
    },
    "new-array": {
      "match": "(?i)\\b(new)\\s+((?:(?i:bool|int|float|string)\\b|(?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*))\\s*(?=\\[)",
      "captures": {
        "1": {
          "name": "keyword.operator.new.papyrus"
        },
        "2": {
          "patterns": [
            {
              "include": "#type-name"
            }
          ]
        }
      }
    },
    "member-call": {
      "match": "(\\.)\\s*((?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "punctuation.accessor.papyrus"
        },
        "2": {
          "name": "entity.name.function.member.papyrus"
        }
      }
    },
    "member": {
      "patterns": [
        {
          "match": "(?i)(\\.)\\s*(length)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.papyrus"
            },
            "2": {
              "name": "support.variable.property.papyrus"
            }
          }
        },
        {
          "match": "(\\.)\\s*((?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.papyrus"
            },
            "2": {
              "name": "variable.other.property.papyrus"
            }
          }
        }
      ]
    },
    "call": {
      "match": "\\b((?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.papyrus"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.papyrus",
          "match": "(?i)\\b(if|elseif|else|endif|while|endwhile|return)\\b"
        },
        {
          "name": "storage.type.papyrus",
          "match": "(?i)\\b(function|endfunction|event|endevent|property|endproperty|state|endstate|scriptname|import)\\b"
        },
        {
          "name": "storage.modifier.papyrus",
          "match": "(?i)\\b(extends|auto|autoreadonly|global|native|hidden|conditional)\\b"
        },
        {
          "name": "support.type.primitive.papyrus",
          "match": "(?i:bool|int|float|string)\\b"
        },
        {
          "name": "constant.language.papyrus",
          "match": "(?i)\\b(true|false|none)\\b"
        },
        {
          "name": "variable.language.papyrus",
          "match": "(?i)\\b(self|parent)\\b"
        },
        {
          "name": "keyword.operator.word.papyrus",
          "match": "(?i)\\b(as|new)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.papyrus",
          "match": "[-+*/%]="
        },
        {
          "name": "keyword.operator.comparison.papyrus",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.papyrus",
          "match": "="
        },
        {
          "name": "keyword.operator.logical.papyrus",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.papyrus",
          "match": "[-+*/%]"
        },
        {
          "name": "punctuation.separator.continuation.papyrus",
          "match": "\\\\\\s*$"
        },
        {
          "name": "punctuation.separator.comma.papyrus",
          "match": ","
        }
      ]
    },
    "variable": {
      "comment": "Any other name: variables, parameters, properties and script names used as receivers.",
      "name": "variable.other.readwrite.papyrus",
      "match": "\\b(?!(?i:as|auto|autoreadonly|else|elseif|endevent|endfunction|endif|endproperty|endstate|endwhile|event|extends|false|function|global|if|import|native|new|none|parent|property|return|scriptname|self|state|true|while|length|bool|int|float|string)\\b)[A-Za-z_]\\w*"
    }
  }
}
