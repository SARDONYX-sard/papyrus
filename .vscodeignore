# Ignore everything, then list what goes into the VSIX.
**/**

!package.json
!readme.md
!LICENSE-*
!language-configuration.json
!flags-language-configuration.json
!syntaxes/**
!schemas/**
!resources/**

# The bundled extension (see extension/vite.config.ts) and the server binary (see build.cjs).
!build/extension.cjs
!build/papyrus_analyzer
!build/papyrus_analyzer.exe

# The grammar generator.
syntaxes/*.mjs
